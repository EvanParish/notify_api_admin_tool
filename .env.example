# Required. Encrypts stored credentials; don't change it once set.
# Generate one with: openssl rand -base64 32
MASTER_KEY=replace_with_a_secure_random_string

# true = sample data, no credentials needed. false = real API (add credentials in Settings).
USE_MOCK_API=false

# Everything below is optional and shows the default.

# API base URL per environment (single-line JSON).
# API_PUBLIC_HOSTS='{"development":"https://dev-api.va.gov/vanotify","perf":"https://sandbox-api.va.gov/vanotify","staging":"https://staging-api.va.gov/vanotify","production":"https://api.va.gov/vanotify"}'

# Environments that are NOT production. Any other name, including localhost tunnels,
# gets the extra production confirmations. Comma-separated, case-insensitive, exact match.
# Setting it replaces the list, so include the defaults you still want.
# NON_PRODUCTION_ENVIRONMENTS=dev,development,local,test,perf,sandbox,staging,stage

# PORT=8080
# DATABASE_PATH=data/app.db

# API timeout in seconds (1-300). Raise it if syncs time out.
# REQUEST_TIMEOUT=30

# Concurrent API calls during sync (1-100).
# MAX_CONCURRENCY=25

# --- Docker only ---

# Release image to run with docker-compose.ghcr.yml, e.g. 1.0.0.
# APP_VERSION=latest

# User/group that runs the app and owns ./data. Set if `id -u` / `id -g` aren't 1000.
# APP_UID=1000
# APP_GID=1000

# Theme preference storage. The compose files already point this into ./data.
# NICEGUI_STORAGE_PATH=.nicegui
