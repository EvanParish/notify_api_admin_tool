# Required: encryption key for stored secrets (use a long random string)
MASTER_KEY=replace_with_a_secure_random_string

# Set to false to connect to real VA Notify API (configure credentials in Settings page)
USE_MOCK_API=false

# API host URLs per environment (JSON object, single line)
API_PUBLIC_HOSTS='{"dev":"https://dev-api.va.gov/vanotify","perf":"https://sandbox-api.va.gov/vanotify","staging":"https://staging-api.va.gov/vanotify","prod":"https://api.va.gov/vanotify"}'

# Local database path (overridden by docker-compose.yml when using Docker)
DATABASE_PATH=data/app.db

# Environment names that are NOT production. Any environment NOT listed here is treated
# as production and gets the maximum-friction confirmation gate for destructive changes —
# including tunnelled/localhost targets, because an SSH or `kubectl port-forward` tunnel
# to GovCloud production also answers on localhost and no URL check can tell the two apart.
# Comma-separated, case-insensitive, matched exactly (not as a substring).
# NON_PRODUCTION_ENVIRONMENTS=dev,development,local,test,perf,sandbox,staging,stage

# Port the web UI listens on (default: 8080)
# PORT=8080

# HTTP request timeout in seconds for calls to the VA Notify API (default: 30,
# clamped to 1-300). Increase if syncs hit ReadTimeouts against slow endpoints.
# REQUEST_TIMEOUT=30

# Docker networking: when running in Docker, the CONTAINER_HOST env var (set
# automatically by docker-compose.yml) remaps localhost/127.0.0.1 URLs in
# API_PUBLIC_HOSTS to host.docker.internal so the container can reach services
# running on the host machine. No manual URL changes needed.

# Docker file ownership: docker-entrypoint.sh starts as root, chowns the bind-mounted
# ./data to this uid:gid, then drops privileges to it via setpriv, so the app never runs
# as root and everything under ./data stays readable from the host. Defaults to 1000:1000.
# Set these if `id -u` / `id -g` report anything else.
#
# This is handled automatically -- there is no manual chown step, and it self-corrects a
# data/ directory previously created as root by the Docker daemon or an earlier container.
# APP_UID=1000
# APP_GID=1000

# Where NiceGUI persists app.storage.user (this app uses it only for the light/dark
# theme preference). Defaults to a .nicegui directory beside the working directory.
# docker-compose.yml overrides it to /app/data/.nicegui, because /app is built as root
# and a container running as the host uid cannot create a directory there -- and because
# the default location is inside the container's ephemeral filesystem, so the preference
# is lost on every `docker compose up --build`.
# NICEGUI_STORAGE_PATH=.nicegui
